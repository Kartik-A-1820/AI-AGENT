OMNIROUTE_API_KEY="your-omniroute-endpoint-key"
OMNIROUTE_BASE_URL="http://localhost:20128/v1"
OMNIROUTE_MODEL="auto"

TAVILY_API_KEY="your-tavily-api-key"

# Persistent assistant state. Generated task files stay in ./agent_working.
AI_AGENT_HOME="D:/AI/assistant"
AI_AGENT_WORKSPACE="./agent_working"
AI_AGENT_VENV="D:/AI/venvs/ai-agent"
GOOGLE_CREDENTIALS_PATH="credentials.json"
GOOGLE_TOKEN_PATH="D:/AI/assistant/google_token.pickle"
GOOGLE_AUTH_BROWSER="C:/Program Files/BraveSoftware/Brave-Browser/Application/brave.exe"

# Optional: only needed for the Gemini-backed image generation tool.
GEMINI_API_KEY="your-gemini-api-key"

# Optional: fill these in if you want cost estimates for your routed model.
OMNIROUTE_INPUT_COST_PER_MILLION="0"
OMNIROUTE_OUTPUT_COST_PER_MILLION="0"
AI_AGENT_TEMPERATURE="0.2"
AI_AGENT_TIMEOUT="120"
AI_AGENT_VERBOSE="false"

# Generated code is opt-in; no host interpreter fallback or runtime pip installs.
AI_AGENT_ENABLE_CODE="false"
# Set to a trusted, already prepared local image, preferably pinned by digest.
AI_AGENT_DOCKER_IMAGE=""
