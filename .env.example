# Chat-model endpoint. Configure a running OmniRoute gateway before launching.
OMNIROUTE_BASE_URL="http://localhost:20128/v1"
OMNIROUTE_MODEL="auto"
OMNIROUTE_API_KEY=""

# Paths are relative to the repository root. These directories are gitignored.
AI_AGENT_HOME="./.local/assistant"
AI_AGENT_WORKSPACE="./agent_working"
GOOGLE_CREDENTIALS_PATH="credentials.json"
GOOGLE_TOKEN_PATH="./.local/assistant/google_token.pickle"

# Optional integrations; leave empty until configured.
TAVILY_API_KEY=""
GEMINI_API_KEY=""

# Optional user-supplied cost estimates for the configured route.
OMNIROUTE_INPUT_COST_PER_MILLION="0"
OMNIROUTE_OUTPUT_COST_PER_MILLION="0"
AI_AGENT_TEMPERATURE="0.2"
AI_AGENT_TIMEOUT="120"
AI_AGENT_VERBOSE="false"

# Generated Python is opt-in; requires an owner-prepared local image.
AI_AGENT_ENABLE_CODE="false"
AI_AGENT_DOCKER_IMAGE=""
